# docker build -t whitepatrick/joke-importer:1.0 . --no-cache
FROM python:3.11-slim-bookworm

# psycopg[binary] ships a prebuilt wheel (no local C compile needed), so no
# gcc/libpq-dev here — that's what made this layer take ~24min under qemu.
RUN apt-get update && apt-get install -y curl

ENV POETRY_VERSION=1.3.2

RUN pip install "poetry==$POETRY_VERSION"

ENV POETRY_NO_INTERACTION=1
# Default 15s read timeout is too tight under qemu emulation on the dev
# laptop's arm64 buildx runs — a slow read (not a dead connection) was
# enough to abort the whole install.
ENV PIP_DEFAULT_TIMEOUT=120

WORKDIR /code

COPY importer.py tracing.py pyproject.toml /code/

ENV PYTHONPATH=/code

ENV DB_CONNECTION_STRING=

RUN /usr/local/bin/poetry install --no-root

ENTRYPOINT ["/usr/local/bin/poetry", "run", "python", "importer.py"]
